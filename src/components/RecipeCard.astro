---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import { Card } from "./ui/Card";
import { markdownToPlainText } from "../lib/markdown";
import type { Recipe } from "../types";
import { ui } from "../utils/icons";
import { duration } from "../utils/time";

interface Props {
  recipe: Pick<
    Recipe,
    "id" | "title" | "description" | "image_url" | "cook_time"
  >;
  /** Shown bottom right on shared recipes */
  authorName?: string | null;
  /** How many households have saved the recipe */
  saveCount?: number;
}

const { recipe, authorName, saveCount } = Astro.props;

const description = markdownToPlainText(recipe.description);
---

<Card className="group flex h-full flex-col" noPadding isClickable>
  <div class="relative h-48 w-full overflow-hidden">
    {
      recipe.image_url ? (
        <Image
          src={recipe.image_url}
          alt=""
          width={640}
          height={384}
          layout="constrained"
          class="h-full w-full object-cover transition-transform group-hover:scale-105"
        />
      ) : (
        <div class="bg-bg text-text-muted flex h-full w-full flex-col items-center justify-center">
          <span class="text-xs font-medium tracking-wider uppercase">
            Uten bilde
          </span>
        </div>
      )
    }
    {
      saveCount != null && (
        <div
          class="bg-surface border-border text-primary absolute right-2 bottom-2 z-10 flex items-center gap-1.5 rounded-full border px-3 py-1 text-sm font-semibold shadow-sm"
          title="Antall som har lagret oppskriften"
        >
          <Icon name={ui.favourite} class="h-4 w-4" />
          {saveCount}
        </div>
      )
    }
  </div>
  <div class="flex flex-1 flex-col p-4">
    <h3 class="text-text mb-2 line-clamp-1 text-lg font-semibold">
      {recipe.title}
    </h3>
    {
      description && (
        <p class="text-text-muted line-clamp-2 text-sm">{description}</p>
      )
    }
    {
      (recipe.cook_time || authorName) && (
        <div class="text-text-muted mt-auto flex items-center gap-1.5 pt-3 text-xs font-medium">
          {recipe.cook_time && (
            <div class="flex items-center gap-1.5">
              <Icon name={ui.clock} class="h-3.5 w-3.5" />
              <span>{duration(recipe.cook_time)}</span>
            </div>
          )}
          {authorName && <span class="ml-auto">av {authorName}</span>}
        </div>
      )
    }
  </div>
</Card>
