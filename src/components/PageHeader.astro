---
import { Icon } from "astro-icon/components";
import { ui } from "../utils/icons";

/**
 * Page title with an optional icon, back link and description.
 *
 * There are two ways to put controls next to the title:
 * - `actions` for buttons: to the right on wide screens, stacked below the
 *   title on narrow ones, since full-width buttons need the room.
 * - `menu` for a dot menu: always next to the title, as it stays small
 *   enough to share the line even on a phone.
 */
interface Props {
  title: string;
  icon?: string;
  description?: string;
  backHref?: string;
}

const { title, icon, description, backHref } = Astro.props;
const hasActions = Astro.slots.has("actions");
const hasMenu = Astro.slots.has("menu");
---

<header
  class:list={[
    "mb-8 flex gap-4",
    hasMenu ? "flex-row items-start justify-between" : "flex-col",
    hasActions && "md:flex-row md:items-center md:justify-between",
  ]}
>
  <div>
    <div class="flex items-center gap-3">
      {
        backHref && (
          <a
            href={backHref}
            aria-label="Tilbake"
            class="text-text hover:text-primary transition-colors"
          >
            <Icon name={ui.back} class="h-6 w-6" />
          </a>
        )
      }
      <h1 class="text-text flex items-center gap-3 text-3xl font-bold">
        {icon && <Icon name={icon} class="h-8 w-8 shrink-0" />}
        {title}
      </h1>
    </div>
    {description && <p class="text-text-muted mt-2">{description}</p>}
  </div>
  {hasMenu && <slot name="menu" />}
  {
    hasActions && (
      <div class="flex flex-col gap-3 md:flex-row">
        <slot name="actions" />
      </div>
    )
  }
</header>
