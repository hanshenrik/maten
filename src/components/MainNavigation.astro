---
import { Icon } from "astro-icon/components";
import { app } from "../utils/icons";
import { IconBackground, type NavSection } from "./IconBackground";

const { pendingInvitesCount } = Astro.locals;
const { pathname } = Astro.url;

const items: {
  section: NavSection;
  href: string;
  label: string;
  isSelected: boolean;
}[] = [
  {
    section: "recipes",
    href: "/recipes",
    label: "Oppskrifter",
    isSelected: pathname.startsWith("/recipes") || pathname === "/library",
  },
  {
    section: "plans",
    href: "/plans",
    label: "Menyer",
    isSelected: pathname.startsWith("/plans"),
  },
  {
    section: "shopping",
    href: "/shopping",
    label: "Handlelista",
    isSelected: pathname === "/shopping",
  },
  {
    section: "settings",
    href: "/settings",
    label: "Innstillinger",
    isSelected: pathname === "/settings",
  },
];
---

<nav
  id="main-navigation"
  aria-label="Hovedmeny"
  class="border-border bg-surface fixed bottom-0 left-0 z-50 w-full border-t px-4 pt-4 pb-[calc(1.5rem+env(safe-area-inset-bottom))]"
>
  <div class="container mx-auto flex justify-around">
    {
      items.map((item) => (
        <a
          href={item.href}
          aria-current={item.isSelected ? "page" : undefined}
          class="text-secondary group relative flex flex-col items-center"
        >
          <IconBackground icon={item.section} isSelected={item.isSelected}>
            <Icon name={app[item.section]} class="h-6 w-6" />
          </IconBackground>
          {item.section === "settings" && pendingInvitesCount > 0 && (
            <span
              class="ring-surface absolute top-0 right-1 h-2.5 w-2.5 rounded-full bg-red-500 shadow-sm ring-2"
              title={`${pendingInvitesCount} ventende invitasjon(er)`}
            />
          )}
          <span class="mt-1 text-xs">{item.label}</span>
        </a>
      ))
    }
  </div>
</nav>

<script>
  //
  // iOS Safari (especially standalone / add-to-home-screen) leaves the
  // layout viewport stale after the keyboard has been open, so
  // `position: fixed` elements end up misplaced - typically a gap below
  // the nav or the nav floating mid-screen. Pin the nav to the *visual*
  // viewport instead: fixed to the top of the layout viewport, then
  // translated down to the bottom of the visible area on every viewport
  // change. Non-iOS/desktop browsers keep the plain fixed positioning.
  //
  {
    const nav = document.getElementById("main-navigation");
    const vv = window.visualViewport;
    if (nav && vv) {
      const isIOS =
        /iP(hone|ad|od)/.test(navigator.userAgent) ||
        (navigator.userAgent.includes("Mac") && navigator.maxTouchPoints > 1);

      if (isIOS) {
        // Anchor to the top of the (stale) layout viewport, then translate
        // down to the bottom of the visual viewport on every change.
        nav.style.top = "0";
        nav.style.bottom = "auto";

        const position = () => {
          const top = vv.height - nav.offsetHeight + vv.offsetTop;
          nav.style.transform = `translateY(${Math.max(0, top)}px)`;
        };

        position();
        vv.addEventListener("resize", position);
        vv.addEventListener("scroll", position);
      }
    }
  }
</script>
