---
/**
 * The main column of a page behind the login wall.
 * `sm` is for forms, `md` for a single thing, `lg` for lists and grids.
 */
interface Props {
  size?: "sm" | "md" | "lg";
}

const { size = "lg" } = Astro.props;

const sizes = {
  sm: "max-w-2xl py-12",
  md: "max-w-4xl py-12",
  lg: "max-w-6xl py-8",
};
---

<div class="flex min-h-dvh flex-col">
  <main class:list={["container mx-auto flex-1 px-4", sizes[size]]}>
    <slot />
  </main>
</div>
