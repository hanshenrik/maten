---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Page from "../../components/Page.astro";
import PageHeader from "../../components/PageHeader.astro";
import { RecipeForm } from "../../components/RecipeForm";
import { displayNameFor, requireSession } from "../../lib/session";
import type { Recipe } from "../../types";

const { supabase, user, householdId } = requireSession(Astro.locals);

// Tags the household already uses, offered as suggestions in the form
const tagsRes = await supabase
  .from("recipes")
  .select("tags")
  .eq("household_id", householdId);
const tagSuggestions = [
  ...new Set(
    (tagsRes.data ?? []).flatMap((row: Pick<Recipe, "tags">) => row.tags ?? []),
  ),
].sort((a, b) => a.localeCompare(b, "no"));
---

<BaseLayout title="Ny godbit">
  <Page size="sm">
    <PageHeader
      title="Lagre en ny godbit"
      backHref="/recipes"
      description="Fyll på med gode smaker og nye favoritter."
    />

    <RecipeForm
      client:load
      userId={user.id}
      householdId={householdId}
      authorName={displayNameFor(user)}
      tagSuggestions={tagSuggestions}
    />
  </Page>
</BaseLayout>
