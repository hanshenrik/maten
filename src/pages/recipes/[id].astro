---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Page from "../../components/Page.astro";
import { Button } from "../../components/ui/Button";
import { IconButton } from "../../components/ui/IconButton";
import { RecipeActions } from "../../components/RecipeActions";
import { RecipeMenu } from "../../components/RecipeMenu";
import { RecipeScaler } from "../../components/RecipeScaler";
import { renderMarkdown, markdownToPlainText } from "../../lib/markdown";
import { fetchRecipeWithIngredients } from "../../lib/queries";
import { requireSession } from "../../lib/session";
import { ui, app } from "../../utils/icons";
import { duration } from "../../utils/time";

const { id } = Astro.params;
const { supabase, householdId } = requireSession(Astro.locals);

// The save state and count only depend on the recipe id, so they are fetched
// alongside the recipe itself instead of waiting for it first. RLS hides
// other households' saves, so the extra queries are safe even for a
// private recipe (they just come back empty).
const [recipe, savedRes, countRes] = await Promise.all([
  id ? fetchRecipeWithIngredients(supabase, id) : null,
  id
    ? supabase
        .from("saved_recipes")
        .select("id")
        .eq("household_id", householdId)
        .eq("recipe_id", id)
        .maybeSingle()
    : Promise.resolve({ data: null }),
  id
    ? supabase
        .from("saved_recipes")
        .select("*", { count: "exact", head: true })
        .eq("recipe_id", id)
    : Promise.resolve({ count: 0 }),
]);

if (!recipe) {
  return Astro.redirect("/404");
}

const isOwner = recipe.household_id === householdId;

const isSaved = !isOwner && recipe.is_public && !!savedRes.data;
const saveCount = recipe.is_public ? (countRes.count ?? 0) : 0;

// Recipes are shared between households, so the markdown is sanitised
const instructionsHtml = renderMarkdown(recipe.instructions);
const description = markdownToPlainText(recipe.description).slice(0, 160);
---

<BaseLayout title={recipe.title} description={description || undefined}>
  <Page size="md">
    <div class="mb-8 flex items-center justify-between">
      <IconButton
        data-back
        data-back-fallback="/recipes"
        icon={ui.back}
        label="Tilbake"
      />
      <RecipeMenu client:idle recipeId={recipe.id} isOwner={isOwner} />
    </div>

    <article
      class="border-border bg-surface overflow-hidden rounded-3xl border"
    >
      {
        recipe.image_url && (
          <Image
            src={recipe.image_url}
            alt=""
            width={1024}
            height={512}
            layout="constrained"
            priority
            class="h-64 w-full object-cover"
          />
        )
      }

      <div class="p-8 md:p-16">
        <div
          class="flex flex-col items-start justify-between gap-4 md:flex-row md:items-center"
        >
          <h1
            class="text-text mb-4 flex items-center gap-3 text-left text-2xl font-bold md:text-4xl"
          >
            <Icon name={app.recipes} class="h-6 w-6 shrink-0 md:h-10 md:w-10" />
            {recipe.title}
          </h1>
          {
            recipe.source_url && (
              <Button
                as="a"
                variant="secondary"
                href={recipe.source_url}
                target="_blank"
                rel="noopener noreferrer"
                className="mb-4 gap-2"
              >
                <Icon name={ui.link} class="h-4 w-4" />
                Originaloppskrift
              </Button>
            )
          }
        </div>

        <div class="mb-8 flex flex-wrap items-center gap-4">
          {
            recipe.cook_time && (
              <div class="text-text-muted flex items-center gap-2 text-sm font-medium">
                <Icon name={ui.clock} class="text-primary h-5 w-5" />
                <span>{duration(recipe.cook_time)}</span>
              </div>
            )
          }
          {
            recipe.is_public && (
              <div class="flex items-center gap-2">
                <div class="bg-primary/10 text-primary flex items-center gap-2 rounded-xl px-4 py-2 text-sm font-medium">
                  <Icon name={app.library} class="h-5 w-5" />
                  <span>Delt i biblioteket</span>
                </div>
                <div
                  class="bg-primary/10 text-primary flex items-center gap-2 rounded-xl px-4 py-2 text-sm"
                  title="Antall som har lagret oppskriften"
                >
                  <Icon name={ui.favourite} class="h-5 w-5" />
                  <span>{saveCount}</span>
                </div>
              </div>
            )
          }
        </div>

        {
          recipe.description?.trim() && (
            <p class="prose-lg text-text-muted mb-4 max-w-none whitespace-pre-line">
              {recipe.description}
            </p>
          )
        }

        <RecipeActions
          client:idle
          recipeId={recipe.id}
          isOwner={isOwner}
          isPublic={recipe.is_public}
          initialIsSaved={isSaved}
        />

        <div class="grid gap-8 md:grid-cols-3">
          <div class="md:col-span-1">
            <h2 class="text-text mb-4 text-xl font-bold">Dette trenger du</h2>
            <RecipeScaler
              client:idle
              ingredients={recipe.ingredients}
              baseServings={recipe.servings}
            />
          </div>

          <div class="md:col-span-2">
            <h2 class="text-text mb-4 text-xl font-bold">Slik gjør du det</h2>
            <div
              class="prose prose-emerald prose-lg text-text-muted max-w-none"
              set:html={instructionsHtml}
            />
          </div>
        </div>
      </div>
    </article>
  </Page>
</BaseLayout>
