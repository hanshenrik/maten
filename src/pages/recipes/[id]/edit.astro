---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Page from "../../../components/Page.astro";
import PageHeader from "../../../components/PageHeader.astro";
import { RecipeForm } from "../../../components/RecipeForm";
import { fetchRecipeWithIngredients } from "../../../lib/queries";
import { displayNameFor, requireSession } from "../../../lib/session";
import type { Recipe } from "../../../types";

const { id } = Astro.params;
const { supabase, user, householdId } = requireSession(Astro.locals);

const recipe = id ? await fetchRecipeWithIngredients(supabase, id) : null;
if (!recipe) {
  return Astro.redirect("/404");
}

// Only the household that owns a recipe can change it
if (recipe.household_id !== householdId) {
  return Astro.redirect(`/recipes/${recipe.id}`);
}

// Tags the household already uses, offered as suggestions in the form
const tagsRes = await supabase
  .from("recipes")
  .select("tags")
  .eq("household_id", householdId);
const tagSuggestions = [
  ...new Set(
    (tagsRes.data ?? []).flatMap((row: Pick<Recipe, "tags">) => row.tags ?? []),
  ),
].sort((a, b) => a.localeCompare(b, "no"));
---

<BaseLayout title={`Endre ${recipe.title}`}>
  <Page size="md">
    <PageHeader
      title="Endre oppskrift"
      backHref={`/recipes/${recipe.id}`}
      description="Endre oppskriftens detaljer og ingredienser"
    />

    <RecipeForm
      client:load
      initialData={recipe}
      userId={user.id}
      householdId={householdId}
      authorName={displayNameFor(user)}
      tagSuggestions={tagSuggestions}
    />
  </Page>
</BaseLayout>
