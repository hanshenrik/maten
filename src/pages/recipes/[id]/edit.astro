---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Page from "../../../components/Page.astro";
import PageHeader from "../../../components/PageHeader.astro";
import { RecipeForm } from "../../../components/RecipeForm";
import { fetchRecipeWithIngredients } from "../../../lib/queries";
import { displayNameFor, requireSession } from "../../../lib/session";

const { id } = Astro.params;
const { supabase, user, householdId } = requireSession(Astro.locals);

const recipe = id ? await fetchRecipeWithIngredients(supabase, id) : null;
if (!recipe) {
  return Astro.redirect("/404");
}

// Only the household that owns a recipe can change it
if (recipe.household_id !== householdId) {
  return Astro.redirect(`/recipes/${recipe.id}`);
}
---

<BaseLayout title={`Endre ${recipe.title}`}>
  <Page size="sm">
    <PageHeader
      centered
      title="Endre oppskrift"
      description="Endre oppskriftens detaljer og ingredienser"
    />

    <RecipeForm
      client:load
      initialData={recipe}
      userId={user.id}
      householdId={householdId}
      authorName={displayNameFor(user)}
    />
  </Page>
</BaseLayout>
