---
import { Icon } from "astro-icon/components";
import BaseLayout from "../layouts/BaseLayout.astro";
import Page from "../components/Page.astro";
import PageHeader from "../components/PageHeader.astro";
import { SettingsForm } from "../components/SettingsForm";
import { app, ui } from "../utils/icons";

// The one page that works without a household, so it can explain what's wrong
const { user, householdId } = Astro.locals;
if (!user) return Astro.redirect("/login");
---

<BaseLayout title="Innstillinger">
  <Page size="sm">
    <PageHeader
      title="Innstillinger"
      icon={app.settings}
      description="Her styrer du alt som har med deg og huset ditt å gjøre."
    />

    <SettingsForm
      client:load
      userId={user.id}
      userEmail={user.email}
      householdId={householdId}
      fullName={user.user_metadata?.full_name}
      avatarUrl={user.user_metadata?.avatar_url}
    />

    <form action="/api/auth/logout" method="POST" class="mt-10">
      <button
        type="submit"
        class="text-secondary mx-auto flex cursor-pointer flex-col items-center border-none bg-transparent p-0 transition-colors hover:text-red-600"
      >
        <Icon name={ui.logout} class="mb-1 h-6 w-6" />
        <span class="mt-1 text-xs">Logg ut</span>
      </button>
    </form>
  </Page>
</BaseLayout>
