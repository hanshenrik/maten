---
import { Icon } from "astro-icon/components";
import BaseLayout from "../layouts/BaseLayout.astro";
import Page from "../components/Page.astro";
import PageHeader from "../components/PageHeader.astro";
import { PlanMenu } from "../components/PlanMenu";
import { PlannedMeal } from "../components/PlannedMeal";
import { Button } from "../components/ui/Button";
import { Card } from "../components/ui/Card";
import { Details } from "../components/ui/Details";
import { EmptyState } from "../components/ui/EmptyState";
import { requireSession } from "../lib/session";
import type { MealPlanWithMeals } from "../types";
import { formatDateRange, formatLongDay, todayISO } from "../utils/date";
import { app, ui } from "../utils/icons";
import { groupMealsByDate, planTitle } from "../utils/mealPlans";

const { supabase, householdId } = requireSession(Astro.locals);

const { data, error } = await supabase
  .from("meal_plans")
  .select("*, planned_meals (*, recipes (id, title, image_url, cook_time))")
  .eq("household_id", householdId)
  .order("start_date", { ascending: false });

if (error) console.error("Error fetching meal plans:", error);

const plans = (data ?? []) as MealPlanWithMeals[];
const today = todayISO();

const activePlans = plans.filter((p) => p.end_date >= today);
const outdatedPlans = plans.filter((p) => p.end_date < today);
---

<BaseLayout title="Hva skal vi ha til middag?">
  <Page>
    <PageHeader title="Mine menyer" icon={app.plans}>
      <Button slot="actions" as="a" href="/plans/new" className="gap-2">
        <Icon name={ui.add} class="h-5 w-5" />
        Ny meny
      </Button>
    </PageHeader>

    {
      activePlans.length > 0 ? (
        <div class="space-y-12">
          {activePlans.map((plan) => (
            <section class="space-y-4">
              <div class="flex items-start justify-between gap-4">
                <a href={`/plans/${plan.id}`} class="group block">
                  <h2 class="text-text group-hover:text-primary text-2xl font-bold transition-colors">
                    {planTitle(plan)}
                  </h2>
                  <p class="text-secondary text-sm font-medium">
                    {formatDateRange({
                      start: plan.start_date,
                      end: plan.end_date,
                    })}
                  </p>
                </a>
                <PlanMenu client:visible planId={plan.id} />
              </div>
              <div class="meal-scroll -mx-4 flex gap-4 overflow-x-auto px-4 pt-4 pb-4">
                {groupMealsByDate(plan.planned_meals).map((day) => {
                  const isToday = day.date === today;
                  return (
                    <div
                      class="w-72 shrink-0"
                      data-today={isToday ? "" : undefined}
                    >
                      <PlannedMeal
                        date={day.date}
                        meals={day.meals}
                        isToday={isToday}
                      />
                    </div>
                  );
                })}
              </div>
            </section>
          ))}
        </div>
      ) : (
        outdatedPlans.length === 0 && (
          <EmptyState>
            <p>Her var det ingen menyer å se!</p>
            <p>Hva med å sette opp en meny for dagene som kommer?</p>
          </EmptyState>
        )
      )
    }

    {
      outdatedPlans.length > 0 && (
        <Details
          className="mt-16"
          summaryClassName="text-xl font-bold"
          title={`Tidligere menyer (${outdatedPlans.length})`}
        >
          <div class="space-y-4">
            {outdatedPlans.map((plan) => (
              <a href={`/plans/${plan.id}`} class="block">
                <Card isClickable>
                  <div class="flex items-center justify-between gap-4">
                    <h2 class="text-text text-xl font-bold">
                      {planTitle(plan)}
                    </h2>
                    <p class="text-text-muted text-sm">
                      {formatDateRange({
                        start: plan.start_date,
                        end: plan.end_date,
                      })}
                    </p>
                  </div>
                  <table class="table-auto">
                    <tbody>
                      {groupMealsByDate(plan.planned_meals).map((day) =>
                        day.meals.map((meal, i) => (
                          <tr>
                            <td class="capitalize">
                              {i === 0 ? formatLongDay(day.date) : ""}
                            </td>
                            <td class="overflow-hidden rounded-xl p-1">
                              {meal.recipe?.image_url ? (
                                <img
                                  src={meal.recipe.image_url}
                                  alt=""
                                  loading="lazy"
                                  class="h-6 w-6 rounded object-cover"
                                />
                              ) : (
                                <div class="bg-bg h-6 w-6 rounded" />
                              )}
                            </td>
                            <td class="p-1">{meal.recipe?.title}</td>
                          </tr>
                        )),
                      )}
                    </tbody>
                  </table>
                </Card>
              </a>
            ))}
          </div>
        </Details>
      )
    }
  </Page>

  <script>
    import { initScrollToToday } from "../utils/scrollToToday";
    initScrollToToday();
  </script>
</BaseLayout>
