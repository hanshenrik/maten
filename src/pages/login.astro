---
import AuthLayout from "../layouts/AuthLayout.astro";
import { Alert } from "../components/ui/Alert";
import { Button } from "../components/ui/Button";
import { Input } from "../components/forms/Input";
import { createSupabaseServerClient } from "../lib/supabase-server";

let errorMessage = "";

if (Astro.request.method === "POST") {
  const formData = await Astro.request.formData();
  const email = formData.get("email")?.toString().trim();
  const password = formData.get("password")?.toString();

  if (email && password) {
    const supabase = createSupabaseServerClient(Astro);
    const { error } = await supabase.auth.signInWithPassword({
      email,
      password,
    });

    if (!error) {
      return Astro.redirect("/");
    }

    errorMessage =
      error.code === "invalid_credentials" ||
      error.message.includes("Invalid login credentials")
        ? "Huff da, vi kjenner ikke igjen e-posten eller passordet. Er du sikker på at det er riktig?"
        : `Det skjedde en liten feil: ${error.message}`;
  } else {
    errorMessage = "Husk å fylle inn både e-post og passord.";
  }
}
---

<AuthLayout
  title="Logg inn"
  heading="Hei igjen!"
  subtitle="Logg inn for å få maten på bordet"
>
  {errorMessage && <Alert className="mb-6">{errorMessage}</Alert>}

  <form method="POST" class="space-y-6">
    <Input
      type="email"
      id="email"
      name="email"
      label="E-post"
      required
      autoComplete="email"
      placeholder="deg@eksempel.no"
    />
    <Input
      type="password"
      id="password"
      name="password"
      label="Passord"
      required
      autoComplete="current-password"
    />
    <Button type="submit" size="lg" fullWidth>Logg inn</Button>
  </form>

  <Fragment slot="footer">
    Har du ikke brukerkonto? <a
      href="/signup"
      class="text-primary font-medium hover:underline">Lag en her</a
    >
  </Fragment>
</AuthLayout>
