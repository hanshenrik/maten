---
import { Icon } from "astro-icon/components";
import BaseLayout from "../layouts/BaseLayout.astro";
import Page from "../components/Page.astro";
import PageHeader from "../components/PageHeader.astro";
import RecipeCard from "../components/RecipeCard.astro";
import { Button } from "../components/ui/Button";
import { EmptyState } from "../components/ui/EmptyState";
import { requireSession } from "../lib/session";
import type { RecipeListItem } from "../types";
import { app, ui } from "../utils/icons";

const { supabase, householdId } = requireSession(Astro.locals);

const [myRecipesRes, savedRecipesRes] = await Promise.all([
  supabase
    .from("recipes")
    .select(
      "id, household_id, title, description, image_url, cook_time, created_at",
    )
    .eq("household_id", householdId),
  supabase
    .from("saved_recipes")
    .select(
      "recipes(id, household_id, title, description, image_url, cook_time, created_at)",
    )
    .eq("household_id", householdId),
]);

if (myRecipesRes.error) {
  console.error("Error fetching recipes:", myRecipesRes.error);
}
if (savedRecipesRes.error) {
  console.error("Error fetching saved recipes:", savedRecipesRes.error);
}

const myRecipes = (myRecipesRes.data ?? []) as RecipeListItem[];
const savedRecipes = (
  (savedRecipesRes.data ?? []) as unknown as {
    recipes: RecipeListItem | null;
  }[]
)
  .map((saved) => saved.recipes)
  .filter((recipe): recipe is RecipeListItem => recipe !== null);

// Newest first
const recipes = [...myRecipes, ...savedRecipes].sort(
  (a, b) => new Date(b.created_at).getTime() - new Date(a.created_at).getTime(),
);
---

<BaseLayout title="Oppskrifter">
  <Page>
    <PageHeader title="Oppskrifter" icon={app.recipes}>
      <Fragment slot="actions">
        <Button as="a" href="/library" variant="secondary" className="gap-2">
          <Icon name={app.library} class="h-5 w-5" />
          Utforsk biblioteket
        </Button>
        <Button as="a" href="/recipes/new" className="gap-2">
          <Icon name={ui.add} class="h-5 w-5" />
          Legg til ny oppskrift
        </Button>
      </Fragment>
    </PageHeader>

    {
      recipes.length > 0 ? (
        <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
          {recipes.map((recipe) => (
            <a href={`/recipes/${recipe.id}`} class="block">
              <RecipeCard recipe={recipe} />
            </a>
          ))}
        </div>
      ) : (
        <EmptyState>
          <p>
            Her var det tomt! Oppskriftsboken din venter på å bli fylt med
            godsaker.
          </p>
          <p>Hva med å legge inn din første favoritt med en gang?</p>
        </EmptyState>
      )
    }
  </Page>
</BaseLayout>
