---
import { Icon } from "astro-icon/components";
import BaseLayout from "../layouts/BaseLayout.astro";
import Page from "../components/Page.astro";
import PageHeader from "../components/PageHeader.astro";
import RecipeCard from "../components/RecipeCard.astro";
import { EmptyState } from "../components/ui/EmptyState";
import { requireSession } from "../lib/session";
import type { Recipe } from "../types";
import { ui, app } from "../utils/icons";

const { supabase } = requireSession(Astro.locals);

type LibraryRecipe = Recipe & { saved_recipes: { count: number }[] };

const { data, error } = await supabase
  .from("recipes")
  .select("*, saved_recipes(count)")
  .eq("is_public", true);

if (error) console.error("Error fetching library recipes:", error);

// Most saved first, then newest
const recipes = ((data ?? []) as LibraryRecipe[])
  .map((recipe) => ({
    ...recipe,
    saveCount: recipe.saved_recipes?.[0]?.count ?? 0,
  }))
  .sort(
    (a, b) =>
      b.saveCount - a.saveCount ||
      new Date(b.created_at).getTime() - new Date(a.created_at).getTime(),
  );
---

<BaseLayout title="Biblioteket">
  <Page>
    <PageHeader
      title="Biblioteket"
      icon={app.library}
      backHref="/recipes"
      description="Gå på oppdagelsesferd i oppskrifter delt av andre brukere. Lagre dine favoritter i din egen samling!"
    />

    {
      recipes.length > 0 ? (
        <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
          {recipes.map((recipe) => (
            <a href={`/recipes/${recipe.id}`} class="group relative block">
              <RecipeCard recipe={recipe} />
              <div
                class="bg-surface border-border text-primary absolute -top-3 -right-3 flex items-center gap-1.5 rounded-full border px-3 py-1 text-sm font-semibold opacity-90 shadow-sm transition-opacity group-hover:opacity-100"
                title="Antall som har lagret oppskriften"
              >
                <Icon name={ui.favourite} class="h-4 w-4" />
                {recipe.saveCount}
              </div>
              {recipe.author_name && (
                <div class="text-text-muted mt-2 px-2 text-sm italic">
                  Av {recipe.author_name}
                </div>
              )}
            </a>
          ))}
        </div>
      ) : (
        <EmptyState className="text-center">
          <p>
            Biblioteket er foreløpig tomt. Bli den første til å dele en
            oppskrift!
          </p>
        </EmptyState>
      )
    }
  </Page>
</BaseLayout>
