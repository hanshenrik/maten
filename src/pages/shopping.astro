---
import BaseLayout from "../layouts/BaseLayout.astro";
import Page from "../components/Page.astro";
import PageHeader from "../components/PageHeader.astro";
import { ShoppingList } from "../components/ShoppingList";
import { requireSession } from "../lib/session";
import type { ShoppingItem } from "../types";
import { app } from "../utils/icons";

const { supabase, householdId, user } = requireSession(Astro.locals);

const { data, error } = await supabase
  .from("shopping_items")
  .select("*")
  .eq("household_id", householdId)
  // Newest first, so items you just added are at the top of the list
  .order("created_at", { ascending: false });

if (error) console.error("Error fetching shopping items:", error);

const items = (data ?? []) as ShoppingItem[];
---

<BaseLayout title="Handleliste">
  <Page size="sm">
    <PageHeader title="Handleliste" icon={app.shopping} />

    <ShoppingList
      client:load
      initialItems={items}
      userId={user.id}
      householdId={householdId}
    />
  </Page>
</BaseLayout>
