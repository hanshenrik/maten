---
import BaseLayout from "../layouts/BaseLayout.astro";
import Page from "../components/Page.astro";
import PageHeader from "../components/PageHeader.astro";
import { ShoppingList } from "../components/ShoppingList";
import { ActiveMembers } from "../components/ActiveMembers";
import { requireSession, displayNameFor } from "../lib/session";
import type { ShoppingItem } from "../types";
import { app } from "../utils/icons";

const { supabase, householdId, user } = requireSession(Astro.locals);

const { data, error } = await supabase
  .from("shopping_items")
  .select("*")
  .eq("household_id", householdId)
  // Newest first, so items you just added are at the top of the list
  .order("created_at", { ascending: false });

if (error) console.error("Error fetching shopping items:", error);

const items = (data ?? []) as ShoppingItem[];

const name = displayNameFor(user);
const avatarUrl =
  (user.user_metadata?.avatar_url as string | undefined) ?? null;
---

<BaseLayout title="Handleliste">
  <Page size="sm">
    <PageHeader title="Handleliste" icon={app.shopping}>
      <Fragment slot="actions">
        <ActiveMembers
          client:load
          householdId={householdId}
          user={{ id: user.id, name, avatarUrl }}
        />
      </Fragment>
    </PageHeader>

    <ShoppingList
      client:load
      initialItems={items}
      userId={user.id}
      householdId={householdId}
    />
  </Page>
</BaseLayout>
