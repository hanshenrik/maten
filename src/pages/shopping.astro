---
import BaseLayout from "../layouts/BaseLayout.astro";
import { ShoppingListComponent } from "../components/ShoppingList";
import { Icon } from "astro-icon/components";
import { app } from "../utils/icons";
import { generateCacheKey } from "../lib/supabase-cache";

const title = "Handleliste";

const { queryCache, supabase, householdId, user } = Astro.locals;

const { data: shoppingItems } = await queryCache.getOrSet(
  generateCacheKey("shopping_items", "household", { household_id: householdId }),
  () => supabase
    .from("shopping_items")
    .select("*")
    .order("created_at", { ascending: true })
);

const initialItems = shoppingItems || [];
---

<BaseLayout title={title}>
  <div class="flex min-h-dvh flex-col">
    <main class="container mx-auto max-w-6xl flex-1 px-4 py-8">
      <h1 class="text-text mb-6 flex items-center gap-3 text-3xl font-bold">
        <Icon name={app.shopping} class="h-8 w-8" />
        Handleliste
      </h1>

      <ShoppingListComponent
        client:load
        initialItems={initialItems}
        userId={user.id}
        householdId={householdId}
      />
    </main>
  </div>
</BaseLayout>
