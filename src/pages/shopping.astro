---
import BaseLayout from "../layouts/BaseLayout.astro";
import Page from "../components/Page.astro";
import PageHeader from "../components/PageHeader.astro";
import { ShoppingList } from "../components/ShoppingList";
import { ActiveMembers } from "../components/ActiveMembers";
import { requireSession, displayNameFor } from "../lib/session";
import type { ShoppingItem, ShoppingItemLog } from "../types";

const { supabase, householdId, user } = requireSession(Astro.locals);

const { data, error } = await supabase
  .from("shopping_items")
  .select("*")
  .eq("household_id", householdId)
  // Newest first, so items you just added are at the top of the list
  .order("created_at", { ascending: false });

if (error) console.error("Error fetching shopping items:", error);

const items = (data ?? []) as ShoppingItem[];

// Every name the household has ever had on the list, for the name
// suggestions. A missing table (migration not run yet) degrades to the
// old behaviour of suggesting only what's on the list.
const { data: logData, error: logError } = await supabase
  .from("shopping_item_log")
  .select("id, name")
  .eq("household_id", householdId);

if (logError && logError.code !== "42P01")
  console.error("Error fetching shopping item log:", logError);

const log = (logData ?? []) as ShoppingItemLog[];

const name = displayNameFor(user);
const avatarUrl =
  (user.user_metadata?.avatar_url as string | undefined) ?? null;
---

<BaseLayout title="Handlelista">
  <Page size="sm">
    <PageHeader title="Handlelista">
      <Fragment slot="menu">
        <ActiveMembers
          client:idle
          householdId={householdId}
          user={{ id: user.id, name, avatarUrl }}
        />
      </Fragment>
    </PageHeader>

    <ShoppingList
      client:load
      initialItems={items}
      initialLog={log}
      userId={user.id}
      householdId={householdId}
    />
  </Page>
</BaseLayout>
