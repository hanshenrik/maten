---
import AuthLayout from "../layouts/AuthLayout.astro";
import { Alert } from "../components/ui/Alert";
import { Button } from "../components/ui/Button";
import { Input } from "../components/forms/Input";
import { createSupabaseServerClient } from "../lib/supabase-server";

let errorMessage = "";
let successMessage = "";

if (Astro.request.method === "POST") {
  const formData = await Astro.request.formData();
  const email = formData.get("email")?.toString().trim();
  const password = formData.get("password")?.toString();

  if (email && password) {
    const supabase = createSupabaseServerClient(Astro);
    const { error } = await supabase.auth.signUp({ email, password });

    if (error) {
      errorMessage = error.message;
    } else {
      successMessage =
        "Herlig! Sjekk e-posten din for å vise at du er du. Etter det er det bare å logge inn.";
    }
  } else {
    errorMessage = "Husk å fylle inn både e-post og passord.";
  }
}
---

<AuthLayout
  title="Bli med"
  heading="Lag deg en konto"
  subtitle="Bli med i Maten og få full kontroll på middagene"
>
  {errorMessage && <Alert className="mb-6">{errorMessage}</Alert>}
  {
    successMessage && (
      <Alert variant="success" className="mb-6">
        {successMessage}
      </Alert>
    )
  }

  {
    !successMessage && (
      <form method="POST" class="space-y-6">
        <Input
          type="email"
          id="email"
          name="email"
          label="E-post"
          required
          autoComplete="email"
          placeholder="deg@eksempel.no"
        />
        <Input
          type="password"
          id="password"
          name="password"
          label="Passord"
          required
          minLength={6}
          autoComplete="new-password"
          placeholder="Minst 6 tegn"
        />
        <Button type="submit" size="lg" fullWidth>
          Kjør på!
        </Button>
      </form>
    )
  }

  <Fragment slot="footer">
    Har du allerede en konto? <a
      href="/login"
      class="text-primary font-medium hover:underline">Logg inn her</a
    >
  </Fragment>
</AuthLayout>
