---
import { Icon } from "astro-icon/components";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Page from "../../components/Page.astro";
import PageHeader from "../../components/PageHeader.astro";
import { PlannedMeal } from "../../components/PlannedMeal";
import { Button } from "../../components/ui/Button";
import { fetchMealPlan } from "../../lib/queries";
import { requireSession } from "../../lib/session";
import { formatDateRange, todayISO } from "../../utils/date";
import { ui } from "../../utils/icons";
import { groupMealsByDate } from "../../utils/mealPlans";

const { id } = Astro.params;
const { supabase } = requireSession(Astro.locals);

const plan = id ? await fetchMealPlan(supabase, id) : null;
if (!plan) {
  return Astro.redirect("/404");
}

const dateRange = formatDateRange({
  start: plan.start_date,
  end: plan.end_date,
});
const title = plan.title || `Meny: ${dateRange}`;
const days = groupMealsByDate(plan.planned_meals);
const today = todayISO();
---

<BaseLayout title={title}>
  <Page size="md">
    <PageHeader
      title={title}
      backHref="/plans"
      description={`Her er menyen deres for ${dateRange}`}
    >
      <Fragment slot="actions">
        <Button
          as="a"
          href={`/plans/${plan.id}/edit`}
          variant="secondary"
          className="gap-2"
        >
          <Icon name={ui.edit} class="h-5 w-5" />
          Gjør endringer
        </Button>
        <Button
          as="a"
          href={`/plans/new?copyFrom=${plan.id}`}
          variant="secondary"
          className="gap-2"
        >
          <Icon name={ui.copy} class="h-5 w-5" />
          Lag kopi
        </Button>
      </Fragment>
    </PageHeader>

    <div class="meal-scroll -mx-4 flex gap-4 overflow-x-auto px-4 pt-4 pb-4">
      {
        days.map((day) => {
          const isToday = day.date === today;
          return (
            <div class="w-72 shrink-0" data-today={isToday ? "" : undefined}>
              <PlannedMeal
                date={day.date}
                meals={day.meals}
                isToday={isToday}
              />
            </div>
          );
        })
      }
    </div>
  </Page>

  <script>
    import { initScrollToToday } from "../../utils/scrollToToday";
    initScrollToToday();
  </script>
</BaseLayout>
