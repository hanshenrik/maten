---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Page from "../../components/Page.astro";
import PageHeader from "../../components/PageHeader.astro";
import { PlannedMeal } from "../../components/PlannedMeal";
import { PlanMenu } from "../../components/PlanMenu";
import { fetchMealPlan } from "../../lib/queries";
import { requireSession } from "../../lib/session";
import { formatDateRange, todayISO } from "../../utils/date";
import { groupMealsByDate } from "../../utils/mealPlans";

const { id } = Astro.params;
const { supabase } = requireSession(Astro.locals);

const plan = id ? await fetchMealPlan(supabase, id) : null;
if (!plan) {
  return Astro.redirect("/404");
}

const dateRange = formatDateRange({
  start: plan.start_date,
  end: plan.end_date,
});
const title = plan.title || `Meny: ${dateRange}`;
const days = groupMealsByDate(plan.planned_meals);
const today = todayISO();
---

<BaseLayout title={title}>
  <Page size="md">
    <PageHeader
      title={title}
      backHref="/plans"
      description={`Her er menyen for ${dateRange}`}
    >
      <PlanMenu
        slot="actions"
        client:load
        planId={plan.id}
        withLinks
        afterDelete="/plans"
        className="self-end md:self-auto"
      />
    </PageHeader>

    <div class="meal-scroll -mx-4 flex gap-4 overflow-x-auto px-4 pt-4 pb-4">
      {
        days.map((day) => {
          const isToday = day.date === today;
          return (
            <div class="w-72 shrink-0" data-today={isToday ? "" : undefined}>
              <PlannedMeal
                date={day.date}
                meals={day.meals}
                isToday={isToday}
              />
            </div>
          );
        })
      }
    </div>
  </Page>

  <script>
    import { initScrollToToday } from "../../utils/scrollToToday";
    initScrollToToday();
  </script>
</BaseLayout>
