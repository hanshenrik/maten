---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Page from "../../components/Page.astro";
import PageHeader from "../../components/PageHeader.astro";
import { MealPlanningWizard } from "../../components/MealPlanningWizard";
import { fetchMealPlan, fetchWizardRecipes } from "../../lib/queries";
import { requireSession } from "../../lib/session";

const { supabase, user, householdId } = requireSession(Astro.locals);

// ?copyFrom=<plan id> starts the wizard with another plan's meals
const copyFrom = Astro.url.searchParams.get("copyFrom");

const [recipes, sourcePlan] = await Promise.all([
  fetchWizardRecipes(supabase),
  copyFrom ? fetchMealPlan(supabase, copyFrom) : null,
]);
---

<BaseLayout title="Ny meny">
  <Page size="md">
    <PageHeader
      title="Ny meny"
      backHref="/plans"
      description="Velg datoer og legg til oppskrifter"
    />

    <MealPlanningWizard
      client:load
      userId={user.id}
      householdId={householdId}
      recipes={recipes}
      sourcePlan={sourcePlan}
    />
  </Page>
</BaseLayout>
