---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Page from "../../../components/Page.astro";
import PageHeader from "../../../components/PageHeader.astro";
import { MealPlanningWizard } from "../../../components/MealPlanningWizard";
import { fetchMealPlan, fetchWizardRecipes } from "../../../lib/queries";
import { requireSession } from "../../../lib/session";

const { id } = Astro.params;
const { supabase, user, householdId } = requireSession(Astro.locals);

const [plan, recipes] = await Promise.all([
  id ? fetchMealPlan(supabase, id) : null,
  fetchWizardRecipes(supabase),
]);

if (!plan) {
  return Astro.redirect("/404");
}

// Only the household that owns a plan can change it
if (plan.household_id !== householdId) {
  return Astro.redirect(`/plans/${plan.id}`);
}
---

<BaseLayout title="Gjør endringer i menyen">
  <Page size="md">
    <PageHeader
      title="Gjør endringer i menyen"
      backHref={`/plans/${plan.id}`}
      description="Her kan du bytte ut datoer og oppskrifter"
    />

    <MealPlanningWizard
      client:load
      userId={user.id}
      householdId={householdId}
      recipes={recipes}
      initialData={plan}
    />
  </Page>
</BaseLayout>
