---
import Analytics from "@vercel/analytics/astro";
import SpeedInsights from "@vercel/speed-insights/astro";
import { ClientRouter } from "astro:transitions";
import "../styles/global.css";
import MainNavigation from "../components/MainNavigation.astro";

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "Maten – din venn på kjøkkenet. Lag menyer, lagre oppskrifter og få matinnkjøpene unnagjort på et blunk.",
} = Astro.props;

// The navigation only makes sense once you're in
const showNavigation = !!Astro.locals.user;
---

<!doctype html>
<html lang="no" class:list={[showNavigation && "bg-surface"]}>
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, viewport-fit=cover"
    />
    <meta name="description" content={description} />
    <title>Maten - {title}</title>

    <link rel="manifest" href="/manifest.json" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#059669" />

    <!-- Runs before paint so the chosen theme never flashes -->
    <script is:inline>
      (() => {
        const theme = localStorage.getItem("theme") || "auto";
        if (theme !== "auto") {
          document.documentElement.dataset.theme = theme;
        }
      })();
    </script>
    <!--
      Marks the user as a keyboard user on the first Tab, so focus rings stay
      hidden for taps and mouse clicks. WebKit shows a ring around tapped
      links, and the router refocuses elements during navigation; we can't
      tell those apart from keyboard focus any other reliable way.
    -->
    <script is:inline>
      const markKeyboardUser = (event) => {
        if (event.key === "Tab") {
          document.documentElement.dataset.keyboardUser = "";
          document.removeEventListener("keydown", markKeyboardUser);
        }
      };
      document.addEventListener("keydown", markKeyboardUser);
    </script>

    <ClientRouter />
  </head>
  <!--
    The document itself never scrolls; only #app-scroll does, and the nav sits
    below it in normal flow. iOS misplaces `position: fixed` elements after the
    keyboard or the Safari toolbar resizes the viewport, so nothing here is fixed.
    <html> is painted like the nav, so the strip Safari shows below <body>,
    above its toolbar, reads as part of the nav.
  -->
  <body class="bg-bg flex h-dvh flex-col overflow-hidden">
    <div id="app-scroll" class="min-h-0 flex-1 overflow-y-auto">
      <slot />
    </div>
    {showNavigation && <MainNavigation />}
    <div
      id="nav-progress"
      aria-hidden="true"
      style="position: fixed; top: 0; left: 0; z-index: 100; height: 3px; width: 0; background: #059669; opacity: 0; transition: width 0.3s ease, opacity 0.3s ease; pointer-events: none;"
    >
    </div>
    <script>
      // Loading feedback for view transition navigations: a slim progress bar
      // at the top of the screen while the next page is being fetched.
      {
        const bar = document.getElementById("nav-progress");
        let barTimer: number | undefined;

        const hideBar = () => {
          if (!bar) return;
          bar.style.opacity = "0";
          bar.style.width = "0";
        };
        const showBar = () => {
          if (!bar) return;
          window.clearTimeout(barTimer);
          bar.style.opacity = "1";
          bar.style.width = "70%";
        };

        document.addEventListener("astro:before-preparation", showBar);
        document.addEventListener("astro:after-preparation", () => {
          if (bar) bar.style.width = "100%";
        });
        // After a deploy the next page links a stylesheet this one lacks. The
        // router inserts it during the swap, and an inserted stylesheet only
        // applies once loaded, so the new page could paint unstyled. Load it
        // before the swap, switched off, and switch it on in the swap itself.
        document.addEventListener("astro:before-preparation", (event) => {
          const load = event.loader;
          event.loader = async () => {
            await load();
            const present = new Set(
              [
                ...document.querySelectorAll<HTMLLinkElement>(
                  'link[rel="stylesheet"]',
                ),
              ].map((link) => link.getAttribute("href")),
            );
            const missing = [
              ...event.newDocument.querySelectorAll<HTMLLinkElement>(
                'head link[rel="stylesheet"]',
              ),
            ]
              .map((link) => link.getAttribute("href"))
              .filter((href): href is string => !!href && !present.has(href));
            await Promise.all(
              missing.map(
                (href) =>
                  new Promise<void>((resolve) => {
                    const link = document.createElement("link");
                    link.rel = "stylesheet";
                    link.href = href;
                    link.media = "not all";
                    link.dataset.pendingStyle = "";
                    link.onload = link.onerror = () => resolve();
                    document.head.append(link);
                  }),
              ),
            );
          };
        });
        // The swap also replaces <html>'s attributes with the incoming page's,
        // which lack the theme and keyboard-user flag the head scripts set
        // (those don't run again). Carry both over, or a chosen theme falls
        // back to the system one on every navigation.
        document.addEventListener("astro:before-swap", (event) => {
          for (const link of document.querySelectorAll<HTMLLinkElement>(
            "link[data-pending-style]",
          )) {
            link.removeAttribute("media");
            delete link.dataset.pendingStyle;
          }

          const current = document.documentElement.dataset;
          const next = event.newDocument.documentElement.dataset;
          if (current.theme) next.theme = current.theme;
          if (current.keyboardUser !== undefined) next.keyboardUser = "";
        });
        document.addEventListener("astro:page-load", () => {
          if (bar) bar.style.width = "100%";
          barTimer = window.setTimeout(hideBar, 100);
        });
      }
    </script>
    <script>
      {
        const scroller = () => document.getElementById("app-scroll");

        // The router saves and restores window scroll, which no longer moves.
        // Keep #app-scroll's position in the history entry instead, so back
        // and forward land where the page was left.
        let saveTimer: number | undefined;
        document.addEventListener(
          "scroll",
          (event) => {
            if (event.target !== scroller()) return;
            window.clearTimeout(saveTimer);
            saveTimer = window.setTimeout(() => {
              const top = scroller()?.scrollTop ?? 0;
              history.replaceState({ ...history.state, appScrollTop: top }, "");
            }, 100);
          },
          { capture: true, passive: true },
        );
        const restore = () => {
          const top = history.state?.appScrollTop;
          if (top) scroller()?.scrollTo(0, top);
        };
        document.addEventListener("astro:before-swap", () =>
          window.clearTimeout(saveTimer),
        );
        document.addEventListener("astro:after-swap", restore);
        restore();

        // iOS pans the window to reveal a focused field even though the
        // document can't scroll, and doesn't always pan back afterwards.
        const unpan = () => {
          if (window.scrollY === 0) return;
          if (
            document.activeElement?.matches(
              "input, textarea, select, [contenteditable]",
            )
          )
            return;
          window.scrollTo(0, 0);
        };
        window.visualViewport?.addEventListener("resize", unpan);
        document.addEventListener("focusout", () =>
          window.setTimeout(unpan, 100),
        );
      }
    </script>
    <script>
      import { navigate } from "astro:transitions/client";

      // Generic "back" handling. Any element with `data-back` goes to the
      // previous in-app page, tracked in a small sessionStorage history for
      // this tab; `data-back-fallback` says where to go when there is none
      // (fresh visit, direct link). Pages can then be reached from anywhere
      // without wiring each back button to a specific route, and it can't
      // dead-end the way history.back() does when the browser stack has no
      // in-app entry to return to.
      {
        const KEY = "maten:history";
        const read = (): string[] => {
          try {
            return JSON.parse(sessionStorage.getItem(KEY) ?? "[]");
          } catch {
            return [];
          }
        };
        const here = () => location.href.split("#")[0];

        const record = () => {
          const stack = read();
          const url = here();
          if (stack.at(-1) === url) return;
          // Returning to an earlier page: drop the pages in between, so
          // "back" from there keeps pointing forwards, not in circles.
          const seen = stack.lastIndexOf(url);
          if (seen === -1) stack.push(url);
          else stack.length = seen + 1;
          sessionStorage.setItem(KEY, JSON.stringify(stack));
        };

        record();
        document.addEventListener("astro:page-load", record);

        document.addEventListener("click", (event) => {
          const target = (event.target as HTMLElement).closest<HTMLElement>(
            "[data-back]",
          );
          if (!target) return;
          const current = here();
          const stack = read();
          let back: string | undefined;
          for (let i = stack.length - 2; i >= 0; i--) {
            if (stack[i] !== current) {
              back = stack[i];
              break;
            }
          }
          void navigate(back ?? target.dataset.backFallback ?? "/");
        });
      }
    </script>
    <!--
      Not in <head>: they render custom elements, which make the parser close
      <head> early and move the stylesheet into <body>. The router replaces
      <body> on every navigation, so each page painted before its CSS loaded.
    -->
    <Analytics />
    <SpeedInsights />
  </body>
</html>
