---
import Analytics from "@vercel/analytics/astro";
import SpeedInsights from "@vercel/speed-insights/astro";
import { ClientRouter } from "astro:transitions";
import "../styles/global.css";
import MainNavigation from "../components/MainNavigation.astro";

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "Maten – din venn på kjøkkenet. Lag menyer, lagre oppskrifter og få matinnkjøpene unnagjort på et blunk.",
} = Astro.props;

// The navigation only makes sense once you're in
const showNavigation = !!Astro.locals.user;
---

<!doctype html>
<html lang="no">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, viewport-fit=cover"
    />
    <meta name="description" content={description} />
    <title>Maten - {title}</title>

    <link rel="manifest" href="/manifest.json" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#059669" />

    <!-- Runs before paint so the chosen theme never flashes -->
    <script is:inline>
      (() => {
        const theme = localStorage.getItem("theme") || "auto";
        if (theme !== "auto") {
          document.documentElement.dataset.theme = theme;
        }
      })();
    </script>

    <Analytics />
    <SpeedInsights />
    <ClientRouter />
  </head>
  <body
    class:list={[
      "bg-bg min-h-dvh",
      showNavigation && "pb-[calc(5rem+env(safe-area-inset-bottom))]",
    ]}
  >
    <slot />
    {showNavigation && <MainNavigation />}
    <div
      id="nav-progress"
      aria-hidden="true"
      style="position: fixed; top: 0; left: 0; z-index: 100; height: 3px; width: 0; background: #059669; opacity: 0; transition: width 0.3s ease, opacity 0.3s ease; pointer-events: none;"
    >
    </div>
    <script>
      // A slim progress bar for view transition navigations: shown while the
      // next page is being fetched, so navigation always feels responsive.
      {
        const bar = document.getElementById("nav-progress");
        let hideTimer: number | undefined;
        const hide = () => {
          if (!bar) return;
          bar.style.opacity = "0";
          bar.style.width = "0";
        };
        const show = () => {
          if (!bar) return;
          window.clearTimeout(hideTimer);
          bar.style.opacity = "1";
          bar.style.width = "70%";
        };
        document.addEventListener("astro:before-preparation", show);
        document.addEventListener("astro:after-preparation", () => {
          if (bar) bar.style.width = "100%";
        });
        document.addEventListener("astro:page-load", () => {
          if (bar) bar.style.width = "100%";
          hideTimer = window.setTimeout(hide, 100);
        });
      }
    </script>
    <script>
      if ("serviceWorker" in navigator && import.meta.env.PROD) {
        window.addEventListener("load", () => {
          navigator.serviceWorker.register("/sw.js").catch((error) => {
            console.error("Service worker registration failed:", error);
          });
        });
      }
    </script>
  </body>
</html>
