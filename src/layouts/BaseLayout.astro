---
import Analytics from "@vercel/analytics/astro";
import SpeedInsights from "@vercel/speed-insights/astro";
import { ClientRouter } from "astro:transitions";
import "../styles/global.css";
import MainNavigation from "../components/MainNavigation.astro";

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "Maten – din venn på kjøkkenet. Lag menyer, lagre oppskrifter og få matinnkjøpene unnagjort på et blunk.",
} = Astro.props;

// The navigation only makes sense once you're in
const showNavigation = !!Astro.locals.user;
---

<!doctype html>
<html lang="no">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, viewport-fit=cover"
    />
    <meta name="description" content={description} />
    <title>Maten - {title}</title>

    <link rel="manifest" href="/manifest.json" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#059669" />

    <!-- Runs before paint so the chosen theme never flashes -->
    <script is:inline>
      (() => {
        const theme = localStorage.getItem("theme") || "auto";
        if (theme !== "auto") {
          document.documentElement.dataset.theme = theme;
        }
      })();
    </script>
    <!--
      Marks the user as a keyboard user on the first Tab, so focus rings stay
      hidden for taps and mouse clicks. WebKit shows a ring around tapped
      links, and the router refocuses elements during navigation; we can't
      tell those apart from keyboard focus any other reliable way.
    -->
    <script is:inline>
      const markKeyboardUser = (event) => {
        if (event.key === "Tab") {
          document.documentElement.dataset.keyboardUser = "";
          document.removeEventListener("keydown", markKeyboardUser);
        }
      };
      document.addEventListener("keydown", markKeyboardUser);
    </script>

    <Analytics />
    <SpeedInsights />
    <ClientRouter />
  </head>
  <body
    class:list={[
      "bg-bg min-h-dvh",
      showNavigation && "pb-[calc(5rem+env(safe-area-inset-bottom))]",
    ]}
  >
    <slot />
    {showNavigation && <MainNavigation />}
    <div
      id="nav-progress"
      aria-hidden="true"
      style="position: fixed; top: 0; left: 0; z-index: 100; height: 3px; width: 0; background: #059669; opacity: 0; transition: width 0.3s ease, opacity 0.3s ease; pointer-events: none;"
    >
    </div>
    <script>
      // Loading feedback for view transition navigations: a slim progress bar
      // at the top of the screen while the next page is being fetched.
      {
        const bar = document.getElementById("nav-progress");
        // Mirrors the keyboard-user flag on <html> so it survives swaps
        let keyboardUser =
          document.documentElement.dataset.keyboardUser !== undefined;
        let barTimer: number | undefined;

        const hideBar = () => {
          if (!bar) return;
          bar.style.opacity = "0";
          bar.style.width = "0";
        };
        const showBar = () => {
          if (!bar) return;
          window.clearTimeout(barTimer);
          bar.style.opacity = "1";
          bar.style.width = "70%";
        };

        document.addEventListener("astro:before-preparation", showBar);
        document.addEventListener("astro:after-preparation", () => {
          if (bar) bar.style.width = "100%";
        });
        // The router copies the next page's stylesheets into the document as
        // it swaps, but a link that is still downloading leaves the new
        // content unstyled for a moment (blue focus rings, wrong colors).
        // Replace the swap with one that first waits for those stylesheets.
        document.addEventListener("astro:before-swap", (event) => {
          const doc = event.newDocument;
          const hrefs = doc
            ? [
                ...doc.querySelectorAll<HTMLLinkElement>(
                  'link[rel="stylesheet"]',
                ),
              ]
                .map((link) => link.getAttribute("href"))
                .filter(
                  (href): href is string =>
                    !!href &&
                    !document.querySelector(
                      `link[rel="stylesheet"][href="${href}"]`,
                    ),
                )
            : [];
          if (hrefs.length === 0) return;

          const doSwap = event.swap.bind(event);
          event.swap = () => {};
          void Promise.allSettled(
            hrefs.map(
              (href) =>
                new Promise<void>((resolve) => {
                  const el = document.createElement("link");
                  el.rel = "stylesheet";
                  el.href = href;
                  el.addEventListener("load", () => resolve(), { once: true });
                  el.addEventListener("error", () => resolve(), { once: true });
                  document.head.append(el);
                }),
            ),
          ).then(() => {
            // A newer navigation may have started while we waited; only
            // this one's swap should still run.
            if (!event.signal.aborted) doSwap();
          });
        });
        // The swap copies the incoming page's root attributes, which drops
        // the keyboard-user flag the head script set; restore it.
        document.addEventListener("keydown", (event) => {
          if (event.key === "Tab") keyboardUser = true;
        });
        document.addEventListener("astro:after-swap", () => {
          if (keyboardUser) {
            document.documentElement.dataset.keyboardUser = "";
          }
        });
        document.addEventListener("astro:page-load", () => {
          if (bar) bar.style.width = "100%";
          barTimer = window.setTimeout(hideBar, 100);
        });
      }
    </script>
    <script>
      // Generic "back" handling. Any element with `data-back` goes to the
      // previous in-app page, tracked in a small sessionStorage history for
      // this tab; `data-back-fallback` says where to go when there is none
      // (fresh visit, direct link). Pages can then be reached from anywhere
      // without wiring each back button to a specific route, and it can't
      // dead-end the way history.back() does when the browser stack has no
      // in-app entry to return to.
      {
        const KEY = "maten:history";
        const read = (): string[] => {
          try {
            return JSON.parse(sessionStorage.getItem(KEY) ?? "[]");
          } catch {
            return [];
          }
        };
        const here = () => location.href.split("#")[0];

        const record = () => {
          const stack = read();
          const url = here();
          if (stack.at(-1) === url) return;
          // Returning to an earlier page: drop the pages in between, so
          // "back" from there keeps pointing forwards, not in circles.
          const seen = stack.lastIndexOf(url);
          if (seen === -1) stack.push(url);
          else stack.length = seen + 1;
          sessionStorage.setItem(KEY, JSON.stringify(stack));
        };

        record();
        document.addEventListener("astro:page-load", record);

        document.addEventListener("click", (event) => {
          const target = (event.target as HTMLElement).closest<HTMLElement>(
            "[data-back]",
          );
          if (!target) return;
          const current = here();
          const stack = read();
          let back: string | undefined;
          for (let i = stack.length - 2; i >= 0; i--) {
            if (stack[i] !== current) {
              back = stack[i];
              break;
            }
          }
          location.href = back ?? target.dataset.backFallback ?? "/";
        });
      }
    </script>
  </body>
</html>
