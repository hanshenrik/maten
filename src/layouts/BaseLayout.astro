---
import Analytics from "@vercel/analytics/astro";
import SpeedInsights from "@vercel/speed-insights/astro";
import { ClientRouter } from "astro:transitions";
import "../styles/global.css";
import MainNavigation from "../components/MainNavigation.astro";

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "Maten – din venn på kjøkkenet. Lag menyer, lagre oppskrifter og få matinnkjøpene unnagjort på et blunk.",
} = Astro.props;

// The navigation only makes sense once you're in
const showNavigation = !!Astro.locals.user;
---

<!doctype html>
<html lang="no">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, viewport-fit=cover"
    />
    <meta name="description" content={description} />
    <title>Maten - {title}</title>

    <link rel="manifest" href="/manifest.json" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#059669" />

    <!-- Runs before paint so the chosen theme never flashes -->
    <script is:inline>
      (() => {
        const theme = localStorage.getItem("theme") || "auto";
        if (theme !== "auto") {
          document.documentElement.dataset.theme = theme;
        }
      })();
    </script>

    <Analytics />
    <SpeedInsights />
    <ClientRouter />
  </head>
  <body
    class:list={[
      "bg-bg min-h-dvh",
      showNavigation && "pb-[calc(5rem+env(safe-area-inset-bottom))]",
    ]}
  >
    <slot />
    {showNavigation && <MainNavigation />}
    <div
      id="nav-progress"
      aria-hidden="true"
      style="position: fixed; top: 0; left: 0; z-index: 100; height: 3px; width: 0; background: #059669; opacity: 0; transition: width 0.3s ease, opacity 0.3s ease; pointer-events: none;"
    >
    </div>
    <script>
      // Loading feedback for view transition navigations: a slim progress bar
      // right away, and after a short delay the old page fades into a
      // skeleton, so slow navigations clearly say "loading" instead of
      // looking stuck on the page you are leaving.
      {
        const bar = document.getElementById("nav-progress");
        let barTimer: number | undefined;
        let skeletonTimer: number | undefined;

        // Queried at call time: the router replaces <main> on every swap.
        const page = () => document.querySelector("main");

        const hideBar = () => {
          if (!bar) return;
          bar.style.opacity = "0";
          bar.style.width = "0";
        };
        const showBar = () => {
          if (!bar) return;
          window.clearTimeout(barTimer);
          bar.style.opacity = "1";
          bar.style.width = "70%";
        };

        const SKELETON_DELAY_MS = 600;
        const showSkeleton = () => {
          page()?.setAttribute("data-navigation-skeleton", "");
        };
        const hideSkeleton = () => {
          page()?.removeAttribute("data-navigation-skeleton");
        };

        document.addEventListener("astro:before-preparation", (event) => {
          showBar();
          // Only skeleton once it's clear the fetch is not instant
          window.clearTimeout(skeletonTimer);
          skeletonTimer = window.setTimeout(showSkeleton, SKELETON_DELAY_MS);
          // If the navigation is aborted (another one wins, the tab is
          // hidden, the network dies), stop pulsing on the old page.
          event.signal?.addEventListener("abort", hideSkeleton);
        });
        document.addEventListener("astro:after-preparation", () => {
          if (bar) bar.style.width = "100%";
        });
        document.addEventListener("astro:before-swap", hideSkeleton);
        document.addEventListener("astro:after-swap", hideSkeleton);
        document.addEventListener("astro:page-load", () => {
          hideSkeleton();
          window.clearTimeout(skeletonTimer);
          if (bar) bar.style.width = "100%";
          barTimer = window.setTimeout(hideBar, 100);
        });

        // The service worker served this page from its cache; a fresh copy
        // has now been fetched. Swap it in, unless the user is in the middle
        // of a navigation or typing (keeps focus and forms intact).
        navigator.serviceWorker?.addEventListener("message", (event) => {
          if (
            event.data?.type !== "page-refreshed" ||
            event.data.url !== window.location.href
          ) {
            return;
          }
          const active =
            document.activeElement instanceof HTMLElement &&
            (document.activeElement.closest("input, textarea") !== null ||
              document.activeElement.isContentEditable);
          if (!active) {
            window.location.reload();
          }
        });
      }
    </script>
    <script>
      if ("serviceWorker" in navigator && import.meta.env.PROD) {
        window.addEventListener("load", () => {
          navigator.serviceWorker.register("/sw.js").catch((error) => {
            console.error("Service worker registration failed:", error);
          });
        });
      }
    </script>
  </body>
</html>
